{
  "name": "PlannedCourse",
  "type": "object",
  "properties": {
    "course_code": {
      "type": "string",
      "title": "Course Code"
    },
    "course_name": {
      "type": "string",
      "title": "Course Name"
    },
    "credits": {
      "type": "number",
      "title": "Credits"
    },
    "term": {
      "type": "string",
      "title": "Planned Term",
      "description": "e.g. Spring 2027, Next semester"
    }
  },
  "required": [
    "course_code"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}