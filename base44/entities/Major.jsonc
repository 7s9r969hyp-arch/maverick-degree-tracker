{
  "name": "Major",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Major Name"
    },
    "degree_type": {
      "type": "string",
      "enum": [
        "BS",
        "BA",
        "AA",
        "Minor",
        "Certificate"
      ],
      "default": "BS"
    },
    "total_credits": {
      "type": "number",
      "title": "Total Credits"
    },
    "description": {
      "type": "string",
      "title": "Description"
    }
  },
  "required": [
    "name",
    "degree_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}